# Base de datos PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname

# Variables para desarrollo local (alternativa a DATABASE_URL)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=postgres
DB_PASSWORD=
DB_PORT=5432

# Correo donde llegan las propuestas de comics y mensajes de soporte
CONTACT_EMAIL=tucorreo@gmail.com

# Contraseña de aplicación de Gmail (no es tu contraseña normal)
# Cómo obtenerla: myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000
